# Copy to .env and fill in.  .env is git-ignored — never commit real keys.

# --- The conversation (required for her to talk) ---
ANTHROPIC_API_KEY=

# --- The live avatar (required for the real Anam face/voice) ---
# Without it the kiosk runs in dev mode: placeholder avatar, browser
# speech in and out, typed-input bar. Whole protocol still runs.
ANAM_API_KEY=

# Optional Anam overrides — defaults are in agent/web.py
# ANAM_AVATAR_ID=
# ANAM_VOICE_ID=
# ANAM_AVATAR_MODEL=

# --- Live price/stock overlay (optional) ---
# Without both, every price is flagged stale and she hedges to
# "let me confirm at the register".
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_STOREFRONT_TOKEN=

# --- Display name override (optional) ---
# STORE_NAME=

# --- Hosting under a subpath (optional) ---
# Leave unset to serve at the domain root (https://example.com/).
# Set to serve under a path instead, e.g. https://example.com/hannah/
# The whole app moves under the prefix - page, /api, /ws and /static - so a
# plain reverse proxy that forwards the path untouched is all you need.
# APP_BASE_PATH=/hannah

# --- Legacy: UE5 local-render path only (agent/voice.py). ---
# NOT used by the web path — Anam does STT and TTS itself.
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
